# ===========================================
# Moovlabs Studio - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# Resend API Key (required for contact form)
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=

# Site URL (optional - defaults to https://www.moovlabs.tech)
# Override for staging/preview deployments
NEXT_PUBLIC_SITE_URL=https://www.moovlabs.tech
